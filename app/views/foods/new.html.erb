<section class="food-page">
  <div class="main-page">
    <div class="back-ico">
      <%= link_to foods_path do %>
        <i class="fa-solid fa-circle-arrow-left fa-2xl" style="color: #ffffff;"></i>
      <% end %>
    </div>
    <!--------- title + form ------------>
    <main>
      <%= form_with model: @food, url: foods_path, local: true, html: { class: "devise-form" } , method: :post do |f| %>
        <h2 class="new-recipe">new food</h2>
        <div class="input-field">
          <%= f.label :name %><br />
          <%= f.text_field :name, autofocus: true, autocomplete: "name" %>
        </div>
        <div class="input-field">
          <%= f.label :measure_unit, "Measuring Unit" %><br />
          <%= f.text_field :measure_unit, autofocus: true, autocomplete: "measure_unit" %>
        </div>
        <div class="input-field">
          <%= f.label :price, "Unit Price" %><br />
          <%= f.number_field :price, step: 0.01, autofocus: true, autocomplete: "price" %>
        </div>

        <div class="actions">
          <%= f.submit class: 'btn-submit' %>
        </div>
      <% end %>
    </main>
  </div>
</section>