<section class="food-page">
  <div class="main-page">
    <%= render 'shared/navbar' %>
    <!--------- title + list if exist --------->
    <div class="list-sec">
      <h2>My Food</h2>
      <!---------- add recipe button ------------->
      <div class="add-rep">
        <%= link_to new_food_path do %>
          <i class="fa-solid fa-plus"></i>
          add food
        <% end %>
      </div>
      <% if @foods.empty? %>
        <div class="empty-list">
          <%= image_tag('notfound.svg') %>
          <span>No Food!!!</span>
        </div>
      <% else %>
        <table>
          <thead>
            <tr>
              <td>Name</td>
              <td>Measuring unit</td>
              <td>Unit price</td>
              <td>Actions</td>
            </tr>
          </thead>
          <tbody>
            <% @foods.each do |food| %>
              <tr>
                <td> <%= food.name %> </td>
                <td> <%= food.measure_unit %> </td>
                <td> $<%=food.price %> </td>
                <td style="display: flex; justify-content: center; padding: 4px 0">
                  <%= button_to food_path(food), class: 'btn-del', id: 'del-food', method: :delete do %>
                    <i class="fa-solid fa-trash"></i>
                    Remove
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</section>