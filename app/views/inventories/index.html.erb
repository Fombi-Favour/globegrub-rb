<section class="inventory-page">
  <div class="main-page">
    <%= render 'shared/navbar' %>
    <!------- title + list if exist ----------->
    <div class="list-sec">
      <h2>My Inventories</h2>
      <!---------- add inventory button ------------->
      <div class="add-rep">
        <%= link_to new_inventory_path do %>
          <i class="fa-solid fa-plus"></i>
          add inventory
        <% end %>
      </div>
      <% if @inventories.empty? %>
        <div class="empty-list">
          <%= image_tag('notfound.svg') %>
          <span>No Inventories!!!</span>
        </div>
      <% else %>
        <div class="recipe-list">
          <% @inventories.each do |inventory| %>
            <div class="list-col">
              <div class="row">
                <%= link_to inventory.name, inventory_path(inventory.id), class: 'name' %>
                <%= button_to inventory_path(inventory.id), class: 'btn-del', method: :delete do %>
                  <i class="fa-solid fa-trash"></i>
                  Delete
                <% end %>
              </div>
              <div class="desc">
                <span> <%= inventory.description %> </span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>