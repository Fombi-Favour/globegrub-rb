<section class="recipe-page">
  <div class="main-page">
    <%= render 'shared/navbar' %>
    <!--------- title + list if exist --------->
    <div class="list-sec">
      <h2>My Recipes</h2>
      <!---------- add recipe button ------------->
      <div class="add-rep">
        <%= link_to new_recipe_path do %>
          <i class="fa-solid fa-plus"></i>
          add recipe
        <% end %>
      </div>
      <% if @recipes.empty? %>
      <div class="empty-list">
        <%= image_tag('notfound.svg') %>
        <span>No Recipes!!!</span>
      </div>
      <% else %>
        <div class="recipe-list">
          <% @recipes.each do |recipe| %>
          <div class="list-col">
            <div class="row">
              <%= link_to recipe.name, recipe_path(recipe.id), class: 'name' %>
              <%= link_to recipes_path, class: 'btn-del', method: :delete do %>
                <i class="fa-solid fa-trash"></i>
                Delete
              <% end %>
            </div>
            <div class="desc">
              <span> <%= recipe.description %> </span>
            </div>
          </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
