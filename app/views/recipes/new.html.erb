<section class="recipe-page">
  <div class="main-page">
    <div class="back-ico">
      <%= link_to authenticated_root_path do %>
        <i class="fa-solid fa-circle-arrow-left fa-2xl" style="color: #ffffff;"></i>
      <% end %>
    </div>
    <!--------- title + form ------------>
    <main>
      <%= form_with model: @recipe, url: recipes_path, local: true, method: :post do |f| %>
        <h2 class="new-recipe">new recipe</h2>
        <div class="rem-field" id="public-rec">
          <%= f.check_box :public %>
          <%= f.label "Public Recipe" %>
        </div>
        <div class="input-field">
          <%= f.label :name %><br />
          <%= f.text_field :name, autofocus: true, autocomplete: "name" %>
        </div>
        <div class="input-field">
          <%= f.label :prep_time, "Preparation time (in hours)" %><br />
          <%= f.number_field :prep_time, step: 0.25, autofocus: true, autocomplete: "prep_time" %>
        </div>
        <div class="input-field">
          <%= f.label :cooking_time, "Cooking time (in hours)" %>
          <%= f.number_field :cooking_time, step: 0.25, autofocus: true, autocomplete: "cooking_time" %>
        </div>
        <div class="input-field">
          <%= f.label :description %>
          <%= f.text_field :description, autofocus: true, autocomplete: "description" %>
        </div>

        <div class="actions">
          <%= f.submit class: 'btn-submit' %>
        </div>

    <% end %>
    </main>
  </div>
</section>