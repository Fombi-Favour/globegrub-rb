<section class="recipe-page">
  <div class="main-page">
    <div class="back-ico">
      <%= link_to recipe_path(@recipe.id) do %>
        <i class="fa-solid fa-circle-arrow-left fa-2xl" style="color: #ffffff;"></i>
      <% end %>
    </div>
    <!--------- title + form ------------>
    <main>
      <%= form_with model: [@recipe, @recipe_food], url: recipes_path, local: true, method: :post, html: { class: "devise-form" } do |f| %>
        <h2 class="new-recipe">new recipe food</h2>
        <div class="input-field">
          <%= f.label :recipe %><br />
          <%= f.text_field :name, value: @recipe.id, disabled: true %>
        </div>
        <div class="input-field">
          <%= f.label :food_id %><br />
          <%= f.collection_select(:food_id, @foods, :id, :name, { prompt: true }, { required: true }) %>
        </div>
        <div class="input-field">
          <%= f.label :quantity %>
          <%= f.number_field :quantity, step: 0.5, autofocus: true, autocomplete: "quantity" %>
        </div>

        <div class="actions">
          <%= f.submit class: 'btn-submit' %>
        </div>

    <% end %>
    </main>
  </div>
</section>