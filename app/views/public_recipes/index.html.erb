<section class="public-page">
  <div class="main-page">
    <%= render 'shared/navbar' %>
    <!------- title + list if exist ----------->
    <div class="list-sec">
      <h2>My Public Recipes</h2>
      <% if @recipes.empty? %>
        <div class="empty-list">
          <%= image_tag('notfound.svg') %>
          <span>No Public Recipes!!!</span>
        </div>
        <% else %>
        <div class="public-list">
          <% @recipes.each do |recipe| %>
          <div class="list-col">
            <div class="row">
              <p> <%= link_to recipe.name, recipe_path(recipe.id) %> </p>
              <span>By: <%= recipe.user.name %> </span>

              <% if user_signed_in? and recipe.user_id == current_user.id %>
                <%= button_to recipe_path(recipe.id), class: 'btn-del', method: :delete do %>
                  <i class="fa-solid fa-trash"></i>
                  Delete
                <% end %>
              <% end %>
            </div>

            <div class="count">
              <span>Total food items: <%= recipe.recipe_foods.count %> </span>
              <span>Total price: $<%= @total %> </span>
            </div>
          </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>